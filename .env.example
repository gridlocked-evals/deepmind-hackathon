# Backend only. Copy to .env; never use a VITE_ prefix for credentials.
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a fallback.
# Optional JSON configuration; paths are relative to the process working directory.
# GATEWAY_CONFIG=gateway.local.json
# Optional authenticated world API; use a separate random token (32+ characters).
# Keep server-side. Browsers receive one-time, role-scoped session tokens instead.
# WORLD_API_TOKEN=
