# Server-only Gemini AI Studio credentials. Never prefix these with VITE_.
# Tier 3 project key:
GEMINI_API_KEY=
# Alternate workshop project key (also issued by Gemini AI Studio):
WORKSHOP_API_KEY=
# Explicit project selection. No automatic key/project fallback.
GEMINI_KEY_PROFILE=primary
# Optional billable world generation; enable deliberately when credits permit.
GENIE_ENABLED=false

# Runtime media and request evidence stay local and are ignored by Git.
CAPTURE_STORAGE_DIR=data/captures
CAPTURE_MAX_BYTES=536870912
OBSERVATION_STORAGE_DIR=data/observations

# Local, durable budgets. These are chosen ceilings, not measured provider quotas.
MODEL_LEDGER_PATH=data/gateway.sqlite3
MODEL_MAX_CONCURRENCY=2
MODEL_MAX_RETRIES=1
MODEL_TIMEOUT_SECONDS=30
MODEL_TOTAL_BUDGET_USD=20
MODEL_DEMO_RESERVE_USD=5
MODEL_STAGE_BUDGET_USD=5
MODEL_STAGE_TOKEN_BUDGET=100000
MODEL_MAX_REQUEST_TOKENS=16384
MODEL_MAX_REQUEST_USD=4
