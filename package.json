{
  "name": "gridlocked",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": ".venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:browser": "npm run build && npm run test:browser:types && playwright test",
    "test:browser:types": "tsc -p tsconfig.browser.json",
    "test:browser:report": "playwright show-report",
    "test:api": ".venv/bin/python -m pytest backend -q",
    "contracts:generate": ".venv/bin/python scripts/export_contracts.py",
    "contracts:check": ".venv/bin/python scripts/export_contracts.py --check",
    "smoke:models": ".venv/bin/python -m backend.gateway.smoke"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "hls.js": "^1.7.3",
    "lucide-react": "1.54.0",
    "maplibre-gl": "6.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.4",
    "vitest": "^4.1.0"
  }
}
