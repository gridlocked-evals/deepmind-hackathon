{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^anc_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "semanticClass": {
          "enum": [
            "travel_lane",
            "bus_lane",
            "bike_lane",
            "parking_lane",
            "sidewalk",
            "crosswalk",
            "plaza",
            "median",
            "planter",
            "signal",
            "signage",
            "vehicle",
            "pedestrian",
            "cyclist",
            "building_facade",
            "other"
          ],
          "title": "Semanticclass",
          "type": "string"
        },
        "region": {
          "discriminator": {
            "mapping": {
              "box": "#/$defs/BoxRegion",
              "polygon": "#/$defs/PolygonRegion"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BoxRegion"
            },
            {
              "$ref": "#/$defs/PolygonRegion"
            }
          ],
          "title": "Region"
        },
        "provenance": {
          "enum": [
            "observed",
            "derived"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "semanticClass",
        "region",
        "provenance"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "BoxRegion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "box",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        },
        "w": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "W",
          "type": "number"
        },
        "h": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "BoxRegion",
      "type": "object"
    },
    "Capture": {
      "additionalProperties": false,
      "description": "Immutable reference to the original evidence. Recording is issue #4.",
      "properties": {
        "id": {
          "pattern": "^cap_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "cameraId": {
          "pattern": "^[A-Za-z0-9-]{1,100}$",
          "title": "Cameraid",
          "type": "string"
        },
        "sourceKind": {
          "enum": [
            "hls",
            "snapshot"
          ],
          "title": "Sourcekind",
          "type": "string"
        },
        "mediaSha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Mediasha256",
          "type": "string"
        },
        "mediaType": {
          "minLength": 1,
          "title": "Mediatype",
          "type": "string"
        },
        "durationS": {
          "maximum": 120.0,
          "minimum": 0,
          "title": "Durations",
          "type": "number"
        },
        "frameCount": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framecount"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "retrievalStartedAt": {
          "format": "date-time",
          "title": "Retrievalstartedat",
          "type": "string"
        },
        "retrievalEndedAt": {
          "format": "date-time",
          "title": "Retrievalendedat",
          "type": "string"
        },
        "captureClock": {
          "enum": [
            "unknown",
            "source_reported"
          ],
          "title": "Captureclock",
          "type": "string"
        },
        "provenance": {
          "const": "observed",
          "default": "observed",
          "title": "Provenance",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "$ref": "#/$defs/Unknown"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "cameraId",
        "sourceKind",
        "mediaSha256",
        "mediaType",
        "durationS",
        "retrievalStartedAt",
        "retrievalEndedAt",
        "captureClock"
      ],
      "title": "Capture",
      "type": "object"
    },
    "EditOperation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^op_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "add",
            "remove",
            "modify",
            "restyle"
          ],
          "title": "Op",
          "type": "string"
        },
        "target": {
          "enum": [
            "travel_lane",
            "bus_lane",
            "bike_lane",
            "parking_lane",
            "sidewalk",
            "crosswalk",
            "plaza",
            "median",
            "planter",
            "signal",
            "signage",
            "vehicle",
            "pedestrian",
            "cyclist",
            "building_facade",
            "other"
          ],
          "title": "Target",
          "type": "string"
        },
        "region": {
          "discriminator": {
            "mapping": {
              "box": "#/$defs/BoxRegion",
              "polygon": "#/$defs/PolygonRegion"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BoxRegion"
            },
            {
              "$ref": "#/$defs/PolygonRegion"
            }
          ],
          "title": "Region"
        },
        "anchorIds": {
          "items": {
            "pattern": "^anc_[A-Za-z0-9-]{4,64}$",
            "type": "string"
          },
          "title": "Anchorids",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "provenance": {
          "const": "inserted",
          "default": "inserted",
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "op",
        "target",
        "region",
        "description"
      ],
      "title": "EditOperation",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "description": "Aggregated outcome for one condition on a locked input set (issue #13).",
      "properties": {
        "schemaVersion": {
          "const": "element119.v1",
          "default": "element119.v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "id": {
          "pattern": "^eval_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "inputSetId": {
          "minLength": 1,
          "title": "Inputsetid",
          "type": "string"
        },
        "inputSetSha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Inputsetsha256",
          "type": "string"
        },
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "isBaseline": {
          "title": "Isbaseline",
          "type": "boolean"
        },
        "captureIds": {
          "items": {
            "pattern": "^cap_[A-Za-z0-9-]{4,64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Captureids",
          "type": "array"
        },
        "worldSessionIds": {
          "items": {
            "pattern": "^world_[A-Za-z0-9-]{4,64}$",
            "type": "string"
          },
          "title": "Worldsessionids",
          "type": "array"
        },
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "provenance": {
          "const": "derived",
          "default": "derived",
          "title": "Provenance",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "inputSetId",
        "inputSetSha256",
        "condition",
        "isBaseline",
        "captureIds",
        "attempts",
        "succeeded",
        "failed",
        "unknown"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "GateCheck": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ],
          "title": "Answer",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer",
        "rationale"
      ],
      "title": "GateCheck",
      "type": "object"
    },
    "GateDecision": {
      "additionalProperties": false,
      "description": "Operational Decisions judgment (issues #8 and #11).",
      "properties": {
        "schemaVersion": {
          "const": "element119.v1",
          "default": "element119.v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "id": {
          "pattern": "^gate_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/GateSubject"
        },
        "modelCall": {
          "$ref": "#/$defs/ModelCall"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/GateCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "accept",
            "reject",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "effect": {
          "enum": [
            "allow_world_creation",
            "block_world_creation",
            "continue",
            "terminate_session",
            "flag_unknown"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "id",
        "subject",
        "modelCall",
        "checks",
        "outcome",
        "effect"
      ],
      "title": "GateDecision",
      "type": "object"
    },
    "GateSubject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "reference_image",
            "navigation_window"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "sessionTime": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessiontime"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "GateSubject",
      "type": "object"
    },
    "MediaTimeRange": {
      "additionalProperties": false,
      "description": "Seconds from the first frame of the captured media.",
      "properties": {
        "startS": {
          "minimum": 0,
          "title": "Starts",
          "type": "number"
        },
        "endS": {
          "minimum": 0,
          "title": "Ends",
          "type": "number"
        }
      },
      "required": [
        "startS",
        "endS"
      ],
      "title": "MediaTimeRange",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "unknownCount": {
          "minimum": 0,
          "title": "Unknowncount",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "n",
        "unknownCount"
      ],
      "title": "Metric",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "Provenance for one inference request. Secrets never appear here.",
      "properties": {
        "id": {
          "pattern": "^call_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "service": {
          "enum": [
            "hydrogen",
            "carbon",
            "nano_banana",
            "decisions",
            "genie"
          ],
          "title": "Service",
          "type": "string"
        },
        "modelId": {
          "minLength": 1,
          "title": "Modelid",
          "type": "string"
        },
        "promptId": {
          "minLength": 1,
          "title": "Promptid",
          "type": "string"
        },
        "configId": {
          "minLength": 1,
          "title": "Configid",
          "type": "string"
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requestid"
        },
        "inputHashes": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputhashes",
          "type": "array"
        },
        "requestedAt": {
          "format": "date-time",
          "title": "Requestedat",
          "type": "string"
        },
        "completedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completedat"
        },
        "latencyMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latencyms"
        },
        "inputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputtokens"
        },
        "outputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputtokens"
        },
        "costUsd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costusd"
        },
        "outcome": {
          "enum": [
            "ok",
            "timeout",
            "quota",
            "invalid_output",
            "error",
            "blocked"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "id",
        "service",
        "modelId",
        "promptId",
        "configId",
        "inputHashes",
        "requestedAt",
        "outcome"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "NavigationEvent": {
      "additionalProperties": false,
      "description": "One control step in a world session (issue #10).",
      "properties": {
        "schemaVersion": {
          "const": "element119.v1",
          "default": "element119.v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "id": {
          "pattern": "^nav_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "worldSessionId": {
          "pattern": "^world_[A-Za-z0-9-]{4,64}$",
          "title": "Worldsessionid",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "sessionTimeS": {
          "minimum": 0,
          "title": "Sessiontimes",
          "type": "number"
        },
        "driver": {
          "enum": [
            "human",
            "hydrogen"
          ],
          "title": "Driver",
          "type": "string"
        },
        "action": {
          "enum": [
            "forward",
            "back",
            "strafe_left",
            "strafe_right",
            "turn_left",
            "turn_right",
            "stop",
            "terminate"
          ],
          "title": "Action",
          "type": "string"
        },
        "durationS": {
          "maximum": 10,
          "minimum": 0,
          "title": "Durations",
          "type": "number"
        },
        "frameSha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framesha256"
        },
        "modelCall": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "id",
        "worldSessionId",
        "sequence",
        "sessionTimeS",
        "driver",
        "action",
        "durationS"
      ],
      "title": "NavigationEvent",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^ob_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "actor",
            "signal_state",
            "lane_use",
            "queue",
            "movement",
            "obstruction",
            "scene"
          ],
          "title": "Kind",
          "type": "string"
        },
        "semanticClass": {
          "enum": [
            "travel_lane",
            "bus_lane",
            "bike_lane",
            "parking_lane",
            "sidewalk",
            "crosswalk",
            "plaza",
            "median",
            "planter",
            "signal",
            "signage",
            "vehicle",
            "pedestrian",
            "cyclist",
            "building_facade",
            "other"
          ],
          "title": "Semanticclass",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "region": {
          "discriminator": {
            "mapping": {
              "box": "#/$defs/BoxRegion",
              "polygon": "#/$defs/PolygonRegion"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BoxRegion"
            },
            {
              "$ref": "#/$defs/PolygonRegion"
            }
          ],
          "title": "Region"
        },
        "time": {
          "$ref": "#/$defs/MediaTimeRange"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "provenance": {
          "enum": [
            "observed",
            "derived"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "semanticClass",
        "label",
        "region",
        "time",
        "confidence",
        "provenance"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObservationBatch": {
      "additionalProperties": false,
      "description": "Hydrogen's evidence for one capture (issue #5).",
      "properties": {
        "schemaVersion": {
          "const": "element119.v1",
          "default": "element119.v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "id": {
          "pattern": "^obs_[A-Za-z0-9-]{4,64}$",
          "title": "Id",
          "type": "string"
        },
        "captureId": {
          "pattern": "^cap_[A-Za-z0-9-]{4,64}$",
          "title": "Captureid",
          "type": "string"
        },
        "modelCall": {
          "$ref": "#/$defs/ModelCall"
        },
        "motionSupported": {
          "title": "Motionsupported",
          "type": "boolean"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "$ref": "#/$defs/Unknown"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "captureId",
        "modelCall",
        "motionSupported"
      ],
