          },
          "minItems": 1,
          "title": "Permissions",
          "type": "array"
        },
        "provenance": {
          "enum": [
            "inserted",
            "generated"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "region",
        "permissions",
        "provenance",
        "evidence"
      ],
      "title": "EditedRegion",
      "type": "object"
    },
    "EvaluationMetric": {
      "additionalProperties": false,
      "properties": {
