          "title": "Unknowns",
          "type": "array"
        },
        "kind": {
          "const": "EvaluationResult",
          "title": "Kind",
          "type": "string"
        },
        "worldSessionId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,95}$",
              "type": "string"
