        "baselineId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,95}$",
          "title": "Baselineid",
          "type": "string"
        },
        "attemptIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,95}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Attemptids",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "evaluatedSeconds": {
          "minimum": 0,
          "title": "Evaluatedseconds",
          "type": "number"
        },
        "unknownSeconds": {
          "minimum": 0,
          "title": "Unknownseconds",
          "type": "number"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/EvaluationMetric"
          },
          "title": "Metrics",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "capture",
        "createdAt",
        "provenance",
        "trace",
        "unknowns",
        "kind",
        "worldSessionId",
        "datasetId",
        "split",
        "baselineId",
        "attemptIds",
        "outcome",
        "evaluatedSeconds",
        "unknownSeconds",
        "metrics"
